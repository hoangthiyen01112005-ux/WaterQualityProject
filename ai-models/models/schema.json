      "required": true
    },
    {
      "name": "Solids",
      "type": "number",
      "required": true
    },
    {
      "name": "Chloramines",
      "type": "number",
      "required": true
    },
    {
      "name": "Sulfate",
      "type": "number",
      "required": true
    },
    {
      "name": "Conductivity",
      "type": "number",
      "required": true
    },
    {
      "name": "Organic_carbon",
      "type": "number",
      "required": true
    },
    {
      "name": "Trihalomethanes",
      "type": "number",
      "required": true
    },
    {
      "name": "Turbidity",
      "type": "number",
      "required": true
    }
  ],
  "feature_order": [
